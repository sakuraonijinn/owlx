app "owlx" {
  meta { description: "Control Frida hooks and mitmproxy on your own test devices"; category: "dev"; owl: 12 }
  title: "owlx"

  // EDIT THIS LINE: the NixOS laptop running nixos/start-engine.sh.
  // OWL requires the scheme and host to be fixed text, so it lives in a let,
  // not a state or an input. The rest of the URL is fixed paths only.
  let api = "http://LAPTOP_IP:8787"

  // This is a LAN service over plain http, so a secret state cannot be used
  // here. Keep the token long, random, and only on your own network.
  state token = "" persist
  state script = "default.js" persist
  state proxyHost = "10.10.10.119" persist
  state proxyPort = "8080" persist
  state result = null
  state problem = ""

  source status = http(token == "" ? null : api + "/api/status", {Authorization: "Bearer " + token}) every 5s json status
  source hooks = http(token == "" ? null : api + "/api/hooks", {Authorization: "Bearer " + token}) every 5s json status
  source procs = http(token == "" ? null : api + "/api/processes", {Authorization: "Bearer " + token}) every 10s json status
  source scripts = http(token == "" ? null : api + "/api/scripts", {Authorization: "Bearer " + token}) every 15s json status
  source events = http(token == "" ? null : api + "/api/events", {Authorization: "Bearer " + token}) every 5s json status

  on result {
    problem = value.ok ? "" : "error ${value.code}: ${value.out}"
  }

  let headers = {Authorization: "Bearer " + token}
  let attached = (hooks.out ?? {}).hooks ?? []
  let processes = take((procs.out ?? {}).processes ?? [], 24)
  let recent = reverse((events.out ?? {}).events ?? [])
  let mitm = (status.out ?? {}).mitm ?? {}
  let frida = (status.out ?? {}).frida ?? {}
  let proxyMode = ((status.out ?? {}).proxy ?? {}).mode ?? "none"

  Column {
    fill: true
    padding: 12
    gap: 9

    Row {
      gap: 8
      align: center
      Text { text: "owlx"; style: title; bold: true; weight: 1 }
      Text { text: frida.connected == true ? "frida online" : "frida offline"; style: small; color: frida.connected == true ? accent : muted }
    }
    Text { text: api; style: small; color: muted; maxLines: 1 }

    Row {
      gap: 6
      align: center
      Input { text: token; placeholder: "token from the laptop"; password: true; weight: 1; onChange: token = value }
    }

    if token == "" {
      Text { text: "Enter the token from ~/.config/owlx/token on the laptop."; style: muted }
    } else {
      Text {
        text: "hooks ${len(attached)} · mitm ${mitm.running == true ? "running" : "stopped"} · proxy ${proxyMode}"
        style: small
        color: muted
      }
      if problem != "" { Text { text: problem; style: small; color: red } }

      Text { text: "attached hooks"; bold: true }
      Box {
        padding: 8
        radius: 8
        background: alpha(background, 0.5)
        Column {
          gap: 4
          if len(attached) == 0 { Text { text: "none"; style: muted } }
          for h in attached {
            Row {
              gap: 8
              align: center
              Text { text: "#${h.pid}"; font: mono; weight: 1 }
              Text { text: h.script; style: small; color: muted; weight: 1 }
              Text {
                text: "detach"
                style: small
                color: red
                onTap: result = post(api + "/api/hooks/${enc(h.pid)}", null, headers, method: "DELETE")
              }
            }
          }
        }
      }

      Text { text: "processes"; bold: true }
      Row {
        gap: 6
        align: center
        Input { text: script; placeholder: "hook script"; weight: 1; onChange: script = value }
      }
      Column {
        weight: 1
        scroll: true
        gap: 2
        if len(processes) == 0 { Text { text: "no processes"; style: muted } }
        for p in processes {
          Row {
            gap: 8
            align: center
            Text { text: "${p.pid}"; font: mono; width: 54; style: small }
            Text { text: p.name; weight: 1; maxLines: 1 }
            Text {
              text: "hook"
              style: small
              color: accent
              onTap: result = post(api + "/api/hooks", {pid: p.pid, script: script}, headers)
            }
          }
        }
      }

      Row {
        gap: 6
        Button {
          text: "mitm on"
          onTap: result = post(api + "/api/mitm", {action: "start", port: int(proxyPort)}, headers)
        }
        Button {
          text: "mitm off"
          onTap: result = post(api + "/api/mitm", {action: "stop"}, headers)
        }
      }
      Row {
        gap: 6
        align: center
        Input { text: proxyHost; placeholder: "proxy host"; weight: 1; onChange: proxyHost = value }
        Input { text: proxyPort; placeholder: "port"; width: 70; onChange: proxyPort = value }
        Text {
          text: "set"
          color: accent
          onTap: result = post(api + "/api/proxy", {action: "set", host: proxyHost, port: int(proxyPort)}, headers)
        }
        Text {
          text: "clear"
          color: muted
          onTap: result = post(api + "/api/proxy", {action: "clear"}, headers)
        }
      }

      Text { text: "recent events"; bold: true }
      Column {
        scroll: true
        gap: 2
        if len(recent) == 0 { Text { text: "nothing yet"; style: muted } }
        for e in take(recent, 30) {
          Text { text: "${e.type}"; font: mono; style: small; maxLines: 1 }
        }
      }
    }
  }
}
